{
  "name": "system-thinking",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "fix": "pnpm format && pnpm lint:md:fix",
    "format": "prettier --write \"**/*.{md,json,yaml,yml,html,css,js}\"",
    "format:check": "prettier --check \"**/*.{md,json,yaml,yml,html,css,js}\"",
    "lint": "pnpm format:check && pnpm lint:md",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:md:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=24.22.1"
  }
}
